{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NTPWEdit Enterprise Windows discovery",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "version",
    "installations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tool": {
      "const": "ntpwcli"
    },
    "version": {
      "type": "string"
    },
    "installations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "drive",
          "driveType",
          "windowsPath",
          "samPath"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "drive": {
            "type": "string",
            "pattern": "^[A-Za-z]:$"
          },
          "driveType": {
            "type": "string"
          },
          "windowsPath": {
            "type": "string"
          },
          "samPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
